[debug] [2026-10-27T19:25:31.624Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/paitai-system:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n// 排檯系統 paitai-system — Firestore 安全規則（v12）\n// 角色：小姐/少爺=1 < 幹部=2 < 經理=3 < 老闆=4；tv=唯讀看板（0）\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() { return request.auth != null; }\n    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }\n    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }\n    function active() { return hasProfile() && me().get('disabled', false) != true; }\n    function rank(r) { return r == '老闆' ? 4 : r == '經理' ? 3 : r == '幹部' ? 2 : (r == '少爺' || r == '小姐') ? 1 : 0; }\n    function lvl() { return active() ? rank(me().role) : 0; }\n    function isTV() { return active() && me().role == 'tv'; }\n    function staff() { return lvl() >= 1; }\n    function reader() { return staff() || isTV(); }\n    function validRole(r) { return r in ['小姐', '少爺', '幹部', '經理', '老闆', 'tv']; }\n\n    // 店家設定、訊息卡、酒單：所有登入人員可讀，經理/老闆可寫\n    match /config/settings {\n      allow read: if reader();\n      allow write: if lvl() >= 3;\n    }\n    // 首次啟用標記：與第一位老闆帳號同一批寫入，之後不可改\n    match /config/boot {\n      allow read: if signedIn();\n      allow create: if signedIn() && !exists(/databases/$(database)/documents/config/boot)\n        && request.resource.data.uid == request.auth.uid\n        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == '老闆';\n      allow update, delete: if false;\n    }\n    // 人員帳號與角色\n    match /users/{uid} {\n      allow read: if (signedIn() && request.auth.uid == uid) || lvl() >= 3;\n      // 第一位老闆（首次啟用）\n      allow create: if signedIn() && request.auth.uid == uid\n        && !exists(/databases/$(database)/documents/config/boot)\n        && getAfter(/databases/$(database)/documents/config/boot).data.uid == uid\n        && request.resource.data.role == '老闆' && request.resource.data.get('disabled', false) == false;\n      // 老闆建立其他人員\n      allow create: if lvl() >= 4 && request.auth.uid != uid && validRole(request.resource.data.role);\n      // 經理/老闆改角色或停用：不能改自己、不能改比自己高的人、不能給超過自己的角色\n      allow update: if lvl() >= 3 && request.auth.uid != uid\n        && rank(resource.data.role) <= lvl()\n        && validRole(request.resource.data.role) && rank(request.resource.data.role) <= lvl()\n        && request.resource.data.staffId == resource.data.staffId;\n      allow delete: if false;\n    }\n    // 當日營業資料（每個營業日一份文件）\n    match /days/{day} {\n      allow read: if reader();\n      allow create, update: if staff();\n      allow delete: if lvl() >= 3;\n    }\n    // 歷史歸檔（每日一份）：幹部以上可看；自動日結任何在班人員可建立；修改（手動匯入）幹部以上\n    match /hist/{day} {\n      allow read: if lvl() >= 2;\n      allow create: if staff();\n      allow update: if lvl() >= 2;\n      allow delete: if lvl() >= 3;\n    }\n    // 寄酒：幹部以上\n    match /wine/{id} {\n      allow read, create, update: if lvl() >= 2;\n      allow delete: if lvl() >= 3;\n    }\n    match /wineLog/{id} {\n      allow read: if lvl() >= 2;\n      allow create: if lvl() >= 2 && request.resource.data.uid == request.auth.uid;\n      allow update, delete: if false;\n    }\n    // 小姐寄放／預支帳本：幹部以上可看、可新增；修改／刪除限經理以上\n    match /ledger/{id} {\n      allow read: if lvl() >= 2;\n      allow create: if lvl() >= 2 && request.resource.data.uid == request.auth.uid;\n      allow update, delete: if lvl() >= 3;\n    }\n    // 操作紀錄：只能新增，不能改不能刪\n    match /audit/{id} {\n      allow read: if lvl() >= 3;\n      allow create: if staff() && request.resource.data.uid == request.auth.uid;\n      allow update, delete: if false;\n    }\n  }\n}\n"}]}}
